# Kopiere diese Datei nach .env und befülle die Werte.
# .env wird automatisch von Taskfile geladen (dotenv).
# NIEMALS committen - .env steht in .gitignore.

# --- GitLab ---
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# --- STACKIT ---
STACKIT_SERVICE_ACCOUNT_TOKEN=
STACKIT_DEFAULT_PROJECT_ID=

# --- Windows (WinRM) ---
WIN_USER=
WIN_PASSWORD=
# Optional: TLS-Cert prüfen (default true). Nur auf "false" setzen, wenn
# eine private CA nicht in den Trust-Store importiert werden kann.
WIN_TLS_VERIFY=true
WIN_TRANSPORT=ntlm
WIN_PORT=5986

# --- Active Directory (LDAP, read-only) ---
# Direkter LDAP(S)-Zugriff auf einen Domain Controller (Simple Bind).
AD_USER=
AD_PASSWORD=
# Optional: Port (default 636 fuer LDAPS, 389 fuer LDAP).
AD_PORT=636
# Optional: LDAPS (default true). Nur bewusst auf "false" (Klartext-LDAP).
AD_USE_SSL=true
# Optional: Server-Zertifikat pruefen (default true). "false" nur bewusst.
AD_TLS_VERIFY=true
# Optional: Pfad zu einer CA-Bundle-Datei (private CA), falls noetig.
AD_CA_BUNDLE=
# Optional: Such-Basis-DN; ohne Angabe der defaultNamingContext des DC.
AD_BASE_DN=

# --- Logging ---
LOG_LEVEL=INFO
