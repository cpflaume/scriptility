# Kopiere diese Datei nach .env und befülle die Werte.
# .env wird automatisch von Taskfile geladen (dotenv).
# NIEMALS committen - .env steht in .gitignore.

# --- GitLab ---
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# --- STACKIT ---
STACKIT_SERVICE_ACCOUNT_TOKEN=
STACKIT_DEFAULT_PROJECT_ID=

# --- Windows (WinRM) ---
WIN_USER=
WIN_PASSWORD=
# Optional: TLS-Cert prüfen (default true). Nur auf "false" setzen, wenn
# eine private CA nicht in den Trust-Store importiert werden kann.
WIN_TLS_VERIFY=true
WIN_TRANSPORT=ntlm
WIN_PORT=5986

# --- Logging ---
LOG_LEVEL=INFO
